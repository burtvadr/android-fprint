#!/bin/sh
# Post-install: create the group, validate the configuration, and never touch a
# user's PAM stack without a backup and a way back.
set -e

case "$1" in
configure)
    if ! getent group phone-auth >/dev/null; then
        groupadd --system phone-auth
    fi

    # Validate before enabling anything. If the daemon cannot start, the
    # installation must not leave a broken PAM stack behind.
    if ! /usr/libexec/phone-authd --check; then
        echo "phone-auth: configuration check failed; not enabling PAM integration" >&2
        exit 0
    fi

    # No PAM stack is modified here. The README documents the one-line change and
    # the required backup, because a wrong PAM edit locks users out of their
    # machines.
    ;;
esac

#DEBHELPER#

exit 0
